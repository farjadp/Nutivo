{
  "name": "nutivo",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @nutivo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:start": "pnpm --filter @nutivo/db db:start",
    "db:stop": "pnpm --filter @nutivo/db db:stop",
    "db:reset": "pnpm --filter @nutivo/db db:reset",
    "db:demo": "pnpm --filter @nutivo/db db:demo",
    "db:status": "pnpm --filter @nutivo/db db:status",
    "db:figfit": "pnpm --filter @nutivo/db db:figfit",
    "bot": "pnpm --filter @nutivo/bot dev",
    "bot:sim": "pnpm --filter @nutivo/bot sim",
    "mobile": "pnpm --filter @nutivo/mobile dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
