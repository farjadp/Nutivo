{
  "expo": {
    "name": "Nutivo",
    "slug": "nutivo",
    "scheme": "nutivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ashavid.nutivo",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fa",
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true
      },
      "appleTeamId": "JN57DU6B4M",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ashavid.nutivo",
      "adaptiveIcon": {
        "backgroundColor": "#007F71",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IRANYekanXFaNum-Regular.ttf",
            "./assets/fonts/IRANYekanXFaNum-Bold.ttf",
            "./assets/fonts/IRANYekanXFaNum-Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#007F71"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Nutivo برای ثبت وعده از روی عکس به دوربین دسترسی می‌خواهد.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#007F71"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Nutivo وزن، قدم‌ها و انرژی فعالیت امروزت را از Apple Health می‌خواند تا کنار کالری‌ات نشان بدهد. چیزی در Health نوشته نمی‌شود.",
          "NSHealthUpdateUsageDescription": "Nutivo چیزی در Apple Health نمی‌نویسد.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {},
      "eas": {
        "projectId": "116c196b-a53c-46f0-ad82-2ba1a90f797e"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ashavid"
  }
}
