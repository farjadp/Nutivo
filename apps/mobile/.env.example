# Copy to .env.local. Values for the local Docker stack (pnpm db:status prints the anon key).
# On the Android emulator, 127.0.0.1/localhost is rewritten to 10.0.2.2 automatically.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The Nutivo web app (serves /api/app/*).
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
