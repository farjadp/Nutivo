/**
 * Generates src/features/mascot/model/nuti-static.ts: نوتی's SVG for every mood as plain strings,
 * for places that cannot render React DOM (the Telegram PNG card, the mobile app). Run after editing nuti.tsx:
 *   pnpm --filter @nutivo/web exec tsx --tsconfig scripts/tsconfig.json scripts/gen-nuti-static.mts
 */
import { writeFileSync } from "node:fs";
import * as React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import type { NutiMood } from "../src/features/mascot/ui/nuti";

// The app compiles JSX with the automatic runtime; tsx here uses the classic one, so expose React globally.
(globalThis as { React?: typeof React }).React = React;
const { Nuti } = await import("../src/features/mascot/ui/nuti");

const moods: NutiMood[] = ["happy", "wink", "wow", "chew", "think", "cheer", "sleepy"];
const out = moods.map((m) => {
  const svg = renderToStaticMarkup(React.createElement(Nuti, { mood: m, size: 120, label: "" })).replace(/ class="[^"]*"/g, "").replace(/ role="img"| aria-label=""/g, "");
  return `  ${m}: ${JSON.stringify(svg)},`;
});
writeFileSync(
  "src/features/mascot/model/nuti-static.ts",
  `// Generated by scripts/gen-nuti-static.mts from ui/nuti.tsx. Do not edit by hand.\nimport type { NutiMood } from "../ui/nuti";\n\nexport const NUTI_SVG: Record<NutiMood, string> = {\n${out.join("\n")}\n};\n`,
);
// The mobile app draws the same faces with react-native-svg.
writeFileSync(
  "../mobile/src/ui/nuti-svg.ts",
  `// Generated by apps/web/scripts/gen-nuti-static.mts from apps/web/src/features/mascot/ui/nuti.tsx. Do not edit by hand.\nimport type { NutiMood } from "@nutivo/core";\n\nexport const NUTI_SVG: Record<NutiMood, string> = {\n${out.join("\n")}\n};\n`,
);
console.log("wrote", moods.length, "moods");
