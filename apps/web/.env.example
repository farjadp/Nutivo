# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
NUTIVO_EXTRACT_MODEL=claude-sonnet-5-5
NUTIVO_REPORT_MODEL=claude-sonnet-5-5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NUTIVO_REPORT_HOUR_LOCAL=21
# Cap on reports written per cron run (cost guard)
NUTIVO_REPORT_MAX_PER_RUN=200

# Vercel cron
CRON_SECRET=

# Development only: skip login and keep meals in the browser
NUTIVO_AUTH_DISABLED=false

# Admin
NUTIVO_SECRETS_KEY=
NUTIVO_ADMIN_EMAILS=

# FigFit food database: non-commercial licence, local use only (on|off)
NUTIVO_FIGFIT=off

# Telegram bot: shared secret between web and apps/bot (openssl rand -hex 32)
NUTIVO_BOT_SECRET=

# AI cost chart in admin (USD per million tokens; check the provider's price list)
NUTIVO_AI_PRICE_IN=
NUTIVO_AI_PRICE_OUT=

# Telegram bot username (without @), for the «اتصال» deep link on the «من» page
NUTIVO_TELEGRAM_BOT_USERNAME=

# Telegram bot token (also used by the nightly push from the web app)
TELEGRAM_BOT_TOKEN=
